# ── 憑證與金鑰：絕不進版控 ──────────────────────────
# 注意：不要寫成 *.json，那會連 package.json / package-lock.json 一起排除
google_chat_token.json
client_secret.json
*secret*.json
token*.json
credentials.json
.env
.env.*
!.env.example

# ── Python ──────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
.venv/
venv/
.pytest_cache/

# ── 前端（Phase 1 起）──────────────────────────────
node_modules/
dist/
.vite/
*.local

# ── 本機資料 ─────────────────────────────────────
# data/ 內含 chatpulse.db（摘要與草稿明文）、其 WAL/SHM 側檔，
# 以及 token.key（OAuth token 的加密金鑰）。整個目錄都不進版控。
data/
*.db
*.db-wal
*.db-shm
*.sqlite3
*.sqlite3-journal
token.key

# ── 作業系統與編輯器 ───────────────────────────────
.DS_Store
.idea/
