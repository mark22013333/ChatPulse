# ── 憑證與金鑰：絕不進版控 ──────────────────────────
# 注意：不要寫成 *.json，那會連 package.json / package-lock.json 一起排除
google_chat_token.json
client_secret.json
*secret*.json
token*.json
credentials.json
.env
.env.*
!.env.example

# ── Python ──────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
.venv/
venv/
.pytest_cache/

# ── 前端（Phase 1 起）──────────────────────────────
node_modules/
dist/
# 例外：儀表板的建置產物**要**進版控（約 700K）。
# 理由是同事拿到專案的方式是 git clone，而讓每個人各自裝一次 Node.js
# 再等 npm install 跑幾分鐘，只為了得到一份人人相同的靜態檔，不划算。
# 產物進版控後 clone 完就有畫面，Node.js 變成只有改前端的人才需要。
# 代價是可能與原始碼漂移，由 dist/.buildinfo.json 的來源雜湊擋住：
# 啟動時比對，不符就自動重建（見 scripts/webapp.py）。
!dashboard/frontend/dist/
.vite/
*.local

# ── 本機資料 ─────────────────────────────────────
# data/ 內含 chatpulse.db（摘要與草稿明文）、其 WAL/SHM 側檔，
# 以及 token.key（OAuth token 的加密金鑰）。整個目錄都不進版控。
data/
*.db
*.db-wal
*.db-shm
*.sqlite3
*.sqlite3-journal
token.key

# ── 測試工具產出 ──────────────────────────────────
# Playwright MCP 會把快照、截圖與 console log 丟在這裡
.playwright-mcp/
# E2E 報告的預設落點（含 add_samples.json 這類真實對話樣本，不該進版控）
tests/e2e/reports/

# ── 作業系統與編輯器 ───────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
